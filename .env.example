# ChoirMate AI — Open-Weight Music Recognition, Audio Export & Voice Coaching Configuration
# 1. Local Open-Weight SmolLM2-360M-Instruct-GGUF model path (auto-downloads to /tmp/choirmate-models if unset)
SMOLLM2_MODEL_PATH="/tmp/choirmate-models/SmolLM2-360M-Instruct-Q4_K_M.gguf"

# 2. Local Python FastAPI OMR & Audio Synthesis Microservice URL
PYTHON_SERVICE_URL="http://127.0.0.1:5001"

# 3. Optional: AssemblyAI Speech-to-Text API Key (Server-Side Only)
# Used ONLY for transcribing spoken music-learning questions and rehearsal reflections after explicit user consent.
# Never expose this key in client-side code. If unset, ChoirMate AI degrades gracefully to typed Q&A and 100% local OMR/playback/audio export.
ASSEMBLYAI_API_KEY=""

# 4. Application URL
APP_URL="http://localhost:3000"
