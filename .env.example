# ==============================================================================
# ChoirMate AI — Server, Vercel Proxy & Windows HOMR Engine Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Node.js Express Gateway & Vercel Server-Side API Proxy
# ------------------------------------------------------------------------------

# Port for the Node.js Express server (default: 3000)
PORT=3000

# Node runtime environment ('development' | 'production')
NODE_ENV="production"

# Server-Side URL of the Python HOMR, MusicXML, SATB & Audio Synthesis Service.
# - Local / Docker / Google AI Studio default: "http://127.0.0.1:5001"
# - On Vercel (or AI Studio remote mode), set this to your permanent HTTPS tunnel
#   URL pointing to your Windows laptop's port 5001:
#   e.g. PYTHON_SERVICE_URL="https://your-permanent-name.ngrok-free.app"
PYTHON_SERVICE_URL="http://127.0.0.1:5001"

# Server-Side Shared Secret used to authenticate requests from Vercel / Express
# to your Windows laptop's Python service over a public HTTPS tunnel.
# Generated automatically by `setup-choirmate.bat` into `.env.windows.local`.
# Set the exact same value on Vercel and your Windows laptop.
# NEVER expose this in VITE_* frontend variables or commit it to GitHub.
PYTHON_SERVICE_SECRET=""

# Allowed CORS origin(s) for cross-origin API requests (default: "*")
CORS_ORIGIN="*"

# Optional: AssemblyAI Speech-to-Text API Key (Server-Side Only).
# Used strictly for transcribing spoken coaching questions after explicit user consent.
ASSEMBLYAI_API_KEY=""

# ------------------------------------------------------------------------------
# 2. Python HOMR & Music-Processing Server (Windows Laptop / Container)
# ------------------------------------------------------------------------------

# Host and port bound by python/service.py (keep 127.0.0.1 so only local tunnel can reach it)
PYTHON_HOST="127.0.0.1"
PYTHON_PORT="5001"

# Path to the local open-weight SmolLM2-360M-Instruct GGUF model binary
SMOLLM2_MODEL_PATH="python/models/SmolLM2-360M-Instruct-Q4_K_M.gguf"

# Set to 1 to automatically download the GGUF model from Hugging Face if not present
SMOLLM2_AUTO_DOWNLOAD="0"

# ------------------------------------------------------------------------------
# 3. Frontend Client (Vite / Vercel)
# ------------------------------------------------------------------------------

# Leave empty so the browser always uses same-origin "/api/*" server-side proxy routes.
# Do NOT put private tunnel URLs or secrets in VITE_API_URL.
VITE_API_URL=""
